# ============================================================================
# Class 10 LMS Backend Environment Variables (SERVER ONLY — NEVER SHIP IN APK)
# Copy to backend/.env and fill with real credentials before starting server.
# ============================================================================

NODE_ENV=development
PORT=4000
TRUST_PROXY=1

# Comma-separated allowed origins (Capacitor Android uses https://localhost or your custom scheme host)
ALLOWED_ORIGINS=https://localhost,http://localhost:5173,http://127.0.0.1:5173,http://10.0.2.2:5173,https://app.class10lms.in

# Supabase PostgreSQL & Auth (Get from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-secret

# Backend Session Token Signing Secrets (Generate >= 32 random hex chars each)
JWT_ACCESS_SECRET=replace-with-at-least-32-chars-random-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-chars-random-refresh-secret
DEVICE_HASH_SECRET=replace-with-at-least-32-chars-random-device-hmac-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Subscription & Device Controls
SUBSCRIPTION_PLAN_CODE=CLASS10_ANNUAL_499
MAX_DEVICES_PER_STUDENT=1
CONCURRENT_SESSION_WINDOW_MINUTES=10

# Razorpay Payment Gateway (Get from Razorpay Dashboard -> Account & Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# Google Play Integrity API Verification
# Distribution mode:
#   sideload   -> Direct APK distribution (enforces device integrity; logs appRecognitionVerdict)
#   play_store -> Google Play distribution (enforces PLAY_RECOGNIZED + device integrity)
# Enforcement mode:
#   monitor -> Verify and log security events without blocking playback (safe initial rollout)
#   enforce -> Block playback authorization when integrity fails policy
GOOGLE_PLAY_PACKAGE_NAME=in.class10lms.ssc
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_SERVICE_ACCOUNT_JSON=
INTEGRITY_DISTRIBUTION_MODE=sideload
INTEGRITY_ENFORCEMENT_MODE=monitor

# Optional Private Stream Token Signing (Bunny Stream / CDN signed URLs — eliminates YouTube logo/redirects)
PRIVATE_STREAM_TOKEN_KEY=
PRIVATE_STREAM_TOKEN_TTL_SECONDS=1800

# Swappable Own-Player Video Storage Provider:
#   none          -> Disabled
#   pikpak_local  -> Local personal testing ONLY (uses locally authenticated pikpak CLI; NOT for commercial launch)
#   cloudflare_r2 -> Recommended commercial production adapter ($0 egress, private bucket + signed edge Worker)
VIDEO_STORAGE_PROVIDER=none
PIKPAK_CLI_PATH=
PUBLIC_API_BASE_URL=
R2_CUSTOM_DOMAIN=
R2_SIGNING_SECRET=
STREAM_TOKEN_TTL_SECONDS=900

# Authorized Offline Video Download Module (NEVER store permanent assets in ephemeral container /tmp)
#   persistent_disk  -> Persistent VPS disk / mounted Render or Railway disk (zero extra cloud subscription)
#   cloudflare_r2    -> Commercial production private R2 bucket ($0 egress; uses R2_CUSTOM_DOMAIN & R2_SIGNING_SECRET)
#   supabase_storage -> Existing Supabase private bucket (small pilot only; check egress limits)
#   pikpak_local     -> Local testing ONLY
OFFLINE_VIDEO_STORAGE_PROVIDER=persistent_disk
OFFLINE_VIDEO_STORAGE_DIR=
OFFLINE_VIDEO_TEMP_DIR=
OFFLINE_DOWNLOAD_TOKEN_TTL_SECONDS=1800
OFFLINE_MAX_UPLOAD_MB=1024
OFFLINE_RETENTION_POLICY=wipe_on_logout
SUPABASE_OFFLINE_BUCKET=lesson-offline-videos
FFMPEG_PATH=
FFPROBE_PATH=

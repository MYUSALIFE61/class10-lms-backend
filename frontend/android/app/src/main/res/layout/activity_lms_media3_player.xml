<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPlayerContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F8FF"
    android:orientation="vertical">

    <!-- Top Dark Lesson Header (Exact Mockup Match) -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0B111E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingTop="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go back"
            android:padding="8dp"
            android:src="@drawable/ic_lms_back" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:text="Chemical Reactions and Equations"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCastInfo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Protected playback"
            android:padding="8dp"
            android:src="@drawable/ic_lms_cast" />
    </LinearLayout>

    <!-- Edge-to-Edge Video Stage with Cinema Overlay Bar (Exact Mockup Match) -->
    <FrameLayout
        android:id="@+id/videoStage"
        android:layout_width="match_parent"
        android:layout_height="238dp"
        android:background="#000000">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:use_controller="false" />

        <!-- Subtle Dynamic Moving Student Watermark -->
        <TextView
            android:id="@+id/txtWatermark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:alpha="0.45"
            android:background="#55000000"
            android:paddingLeft="8dp"
            android:paddingTop="3dp"
            android:paddingRight="8dp"
            android:paddingBottom="3dp"
            android:text="Class 10 SSC LMS"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Floating Top Fullscreen Exit Bar (Hidden until user taps video in fullscreen) -->
        <LinearLayout
            android:id="@+id/fsTopOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#B3000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingTop="10dp"
            android:paddingRight="14dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtFsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnFsExit"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:backgroundTint="#DC2626"
                android:minWidth="0dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="Exit"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Gradient Scrim Overlay: Thin Blue SeekBar + Minimal White Controls -->
        <LinearLayout
            android:id="@+id/controlsDeck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_player_bottom_scrim"
            android:orientation="vertical"
            android:paddingLeft="10dp"
            android:paddingTop="18dp"
            android:paddingRight="10dp"
            android:paddingBottom="8dp">

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:progressDrawable="@drawable/seekbar_track_blue"
                android:splitTrack="false"
                android:thumb="@drawable/seekbar_thumb_white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Play or Pause"
                    android:padding="6dp"
                    android:src="@drawable/ic_lms_pause" />

                <TextView
                    android:id="@+id/txtTimeDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="00:00 / 00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnRewind"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:text="-10s"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnForward"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:text="+10s"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="4dp"
                    android:background="#44FFFFFF"
                    android:gravity="center"
                    android:paddingLeft="7dp"
                    android:paddingRight="7dp"
                    android:text="1x"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnVolume"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mute or Unmute"
                    android:padding="5dp"
                    android:src="@drawable/ic_lms_volume_on" />

                <ImageButton
                    android:id="@+id/btnFullscreen"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle fullscreen"
                    android:padding="5dp"
                    android:src="@drawable/ic_lms_fullscreen" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/loadingSpinner"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/errorOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E60B111E"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Unable to stream video."
                android:textColor="#FCA5A5"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#1152D4"
                android:text="Retry Stream"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Native Screen Recording & Screen Sharing Protection Overlay (Topmost Layer) -->
        <ScrollView
            android:id="@+id/screenProtectionOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FA070F22"
            android:clickable="true"
            android:fillViewport="true"
            android:focusable="true"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="14dp"
                android:paddingTop="10dp"
                android:paddingRight="14dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_protection_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingLeft="16dp"
                    android:paddingTop="14dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="14dp">

                    <ImageView
                        android:id="@+id/imgProtectionShield"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Security warning"
                        android:src="@drawable/ic_lms_security_shield" />

                    <TextView
                        android:id="@+id/txtProtectionHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:letterSpacing="0.04"
                        android:text="SCREEN RECORDING DETECTED!"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtProtectionMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="For the protection of educational content, video playback has been temporarily paused.\n\nPlease stop screen recording or screen sharing to continue watching your lesson."
                        android:textColor="#CBD5E1"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/badgeProtectionWarning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_warning_pill_orange"
                        android:gravity="center"
                        android:paddingLeft="12dp"
                        android:paddingTop="4dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="4dp"
                        android:text="● Screen Recording Active — Playback Locked"
                        android:textColor="#FDBA74"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnProtectionResume"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_resume_btn_blue"
                        android:enabled="false"
                        android:minWidth="168dp"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:text="▶   Resume Lesson"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:backgroundTint="@null" />
                </LinearLayout>
            </FrameLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Lesson Info / Notes / Q&A Section (Exact Mockup Match — Hidden in Fullscreen) -->
    <LinearLayout
        android:id="@+id/lessonDetailsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <!-- 3 Underline Tabs: Lesson Info | Notes | Q&A -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tabLessonInfo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTabInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Lesson Info"
                    android:textColor="#1152D4"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/indTabInfo"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:background="#1152D4" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabNotes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTabNotes"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Notes"
                    android:textColor="#586C91"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/indTabNotes"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:background="#1152D4"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabQA"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTabQA"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Q&amp;A"
                    android:textColor="#586C91"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/indTabQA"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:background="#1152D4"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2ECFF" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/txtSectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="About this Lesson"
                    android:textColor="#0F214D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSectionBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="26dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Learn Class 10 SSC concepts step-by-step in our protected video player."
                    android:textColor="#334B74"
                    android:textSize="14sp" />

                <!-- Full-Width Glossy Royal-Blue Pill Button: ✓ Mark as Complete -->
                <Button
                    android:id="@+id/btnMarkComplete"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_lms_pill_primary"
                    android:text="✓   Mark as Complete"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
